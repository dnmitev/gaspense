# Copy to `.env` and adjust. `.env` is gitignored; only this template is tracked.
#
# THIS IS A PUBLIC REPOSITORY. Never put a real credential in this file.
# Every value below is a local-development placeholder.

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
# Matches the Docker Postgres in docker-compose.yml — start it with
# `docker compose up -d`.
#
# Prisma 7 reads this via prisma.config.ts, not prisma/schema.prisma; the
# datasource block no longer accepts connection URLs.
DATABASE_URL="postgresql://gaspense:gaspense_local_dev@localhost:5433/gaspense_dev?schema=public"

# The database the TEST SUITES own. A second database on the same container as
# DATABASE_URL above — same host, same credentials, different name.
#
# This exists because the integration suite TRUNCATES every table on every run.
# Sharing one database with development meant a test run wiped the signed-in
# account and the demo data; now it only ever wipes this one.
#
# Create and migrate it with:  npm run db:test:setup
#
# Leaving this unset makes the suites fall back to DATABASE_URL — which is how CI
# works, because CI already points DATABASE_URL at a throwaway `gaspense_test`.
# Locally, leaving it unset means the suites truncate your development database.
TEST_DATABASE_URL="postgresql://gaspense:gaspense_local_dev@localhost:5433/gaspense_test?schema=public"

# Optional. Prisma creates a temporary shadow database to detect schema drift
# during `migrate dev`. Set this only if the main user cannot create databases,
# which some managed hosts disallow. Leave unset locally.
# SHADOW_DATABASE_URL=""

# ─────────────────────────────────────────────────────────────
# Authentication (NextAuth v5 / Auth.js)
# ─────────────────────────────────────────────────────────────
# Generate with: npx auth secret
AUTH_SECRET="replace-me-generate-with-npx-auth-secret"

# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and register this authorised redirect URI for local development:
#   http://localhost:3000/api/auth/callback/google
#
# Put the real values in .env (gitignored) — NEVER in this file.
AUTH_GOOGLE_ID="replace-me.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="replace-me"

# Required when serving a PRODUCTION build outside a platform Auth.js recognises.
# Without it, `next start` rejects every session read with UntrustedHost — dev mode
# trusts localhost automatically, so the failure only appears against a real build.
# Vercel sets this itself; the e2e suite sets it in playwright.config.ts.
# AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Production notes (not needed for local development)
# ─────────────────────────────────────────────────────────────
# Supabase exposes two connection paths: a pooled one (pgbouncer) for
# short-lived serverless connections, and a direct one for migrations. Prisma 7
# removed the schema-level `directUrl` that used to express this split, so it is
# handled at deploy time instead — point DATABASE_URL at the direct connection
# when running migrations, and use the pooled connection at runtime.
#
# ⚠️ That shell state — DATABASE_URL exported at a real database — is precisely the
# one in which running the test suites used to be destructive. Two things now stop it:
#
#   1. The suites prefer TEST_DATABASE_URL and overwrite DATABASE_URL with it for the
#      duration of the run, so the exported value is never connected to.
#   2. Even with TEST_DATABASE_URL unset, the truncate path REFUSES any database that
#      is not both local and named `*_test`. A remote host is refused; so is a local
#      database called anything else, including gaspense_dev.
#
# So this is a guarantee, not a convention — and there is no override flag.
#
# Connection pooling on Vercel serverless is a known open concern for this
# project; see .paul/STATE.md. Nothing here is wired up yet.
