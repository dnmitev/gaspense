# ─────────────────────────────────────────────────────────────
# Secrets — THIS IS A PUBLIC REPOSITORY
# Real credentials live only in Vercel / Supabase / GitHub Actions
# environment variables. Never commit them.
#
# Order matters: the broad .env* rule must come BEFORE the
# .env.example negation, or git's last-matching-rule wins and the
# negation becomes dead.
# ─────────────────────────────────────────────────────────────
.env
.env.*
*.env

# ...but the placeholder template is tracked on purpose.
!.env.example

# Stray credential files
*.pem
*.key
secrets.json
service-account*.json

# ─────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# ─────────────────────────────────────────────────────────────
# Build output
# ─────────────────────────────────────────────────────────────
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
.turbo/
.swc/

# ─────────────────────────────────────────────────────────────
# Tests and coverage
# ─────────────────────────────────────────────────────────────
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
test-results/
blob-report/

# ─────────────────────────────────────────────────────────────
# Local tooling artifacts
#
# NOTE: .claude/worktrees/ only — .claude/settings.json is tracked
# deliberately (it carries this repo's bgIsolation setting).
# .paul/ and projects/ are the tracked project brain — never ignore them.
# ─────────────────────────────────────────────────────────────
.claude/worktrees/
.vercel/
.supabase/
supabase/.temp/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────
# OS and editor cruft
# ─────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/

# VS Code: ignore per-user state, keep shared workspace config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
