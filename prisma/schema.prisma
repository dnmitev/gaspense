// Gaspense data model.
//
// Scope: seven entities. Attachment landed in 04-03; VignetteCheck in 05-01,
// after the research spike established what the service actually returns.
// `Fine` follows in 05-02 — its shape depends on the МВР response, whose fine
// object has been recorded from a third party's fixtures but not yet observed
// live. See docs/ARCHITECTURE.md.
//
// Prisma 7 note: connection URLs live in prisma.config.ts, not here — the
// datasource block no longer accepts `url` or `directUrl`.

generator client {
  provider = "prisma-client"
  // Deliberately NOT the default "../app/generated/prisma": `app/` is the Next.js
  // App Router tree, and generated files there risk being treated as routes and
  // get picked up by lint/format.
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum FuelType {
  PETROL
  DIESEL
  LPG
  ELECTRIC
  HYBRID
  OTHER
}

enum OdometerSource {
  MANUAL
  EXPENSE
}

/// Shaped to satisfy NextAuth's Prisma adapter, so plan 02-04 can wire auth
/// without migrating this table. Account/Session/VerificationToken arrive with
/// the adapter itself in 02-04.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cars       Car[]
  categories Category[]

  // NextAuth adapter relations. These add no columns to User — they are
  // Prisma-level relations only, so the migration stays additive.
  accounts Account[]
  sessions Session[]
}

/// Owned by NextAuth's Prisma adapter. Field names are snake_case because the
/// adapter writes OAuth response fields verbatim — do not "tidy" them.
///
/// `refresh_token` is what Phase 6's Google Drive export depends on: it is the
/// only place an offline-access token is persisted.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Owned by NextAuth's Prisma adapter. Database session strategy: a row here
/// means a live login, which is what makes sessions revocable.
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Owned by NextAuth's Prisma adapter. Unused with Google-only sign-in, but the
/// adapter's interface requires the model to exist.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Car {
  id           String   @id @default(cuid())
  userId       String
  licensePlate String
  make         String?
  model        String?
  year         Int?
  nickname     String?
  fuelType     FuelType @default(PETROL)

  /// Soft delete. Deleting a car must never destroy its expense history, so
  /// every car query must filter `deletedAt: null`. Expenses and odometer
  /// readings hard-delete by contrast.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses         Expense[]
  odometerReadings OdometerReading[]
  attachments      Attachment[]
  vignetteChecks   VignetteCheck[]

  @@index([userId])
  @@index([deletedAt])
}

model Category {
  /// null = system default, seeded for everyone. Set = a user's own category.
  ///
  /// NOTE: Postgres treats NULLs as distinct in unique constraints, so a
  /// @@unique([userId, name]) would NOT prevent duplicate system defaults. The
  /// partial unique index enforcing that lives in the migration SQL instead.
  id     String  @id @default(cuid())
  userId String?
  name   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@index([userId])
}

model Expense {
  id         String   @id @default(cuid())
  carId      String
  categoryId String
  date       DateTime

  /// Money as integer minor units (euro cents), never a float or Decimal.
  /// Prisma's Decimal returns Decimal.js instances that do not survive the
  /// Next.js server→client boundary as numbers, and integer cents gives exact
  /// arithmetic plus trivial SUM() for Phase 3's reporting. EUR-only makes a
  /// single minor unit safe.
  amountCents Int

  notes String?

  // Fuel-specific, all optional — only set on fuel expenses.
  //
  // `liters` is a Float rather than Decimal: unlike money, no exact-cent
  // arithmetic depends on it, so double precision is ample for L/100km and it
  // avoids the Decimal.js serialisation problem.
  //
  // pricePerLiter is deliberately NOT stored — it is amountCents / liters, and a
  // stored derived value can drift from its inputs. Compute it where displayed.
  liters   Float?
  station  String?
  fullTank Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  car      Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// The odometer reading captured when this expense was recorded, if any.
  /// Deleting the expense deletes the reading — see OdometerReading.expenseId.
  odometerReading OdometerReading?

  attachments Attachment[]

  @@index([carId])
  @@index([date])
  @@index([categoryId])
}

/// What a vignette check found, and when.
enum VignetteOutcome {
  /// An active Bulgarian vignette exists.
  ACTIVE
  /// A definite "no active vignette" from the service.
  NONE
  /// The service could not be read. ⚠️ NEVER display this as NONE.
  UNAVAILABLE
}

/// One row per vignette check — a log, not columns on `Car`.
///
/// The same shape as `OdometerReading`, and for the same reason: the latest row
/// *is* the current state, and it also answers "when did we last look", which
/// five denormalised columns on `Car` would not. History costs nothing here.
///
/// **`UNAVAILABLE` rows are stored deliberately.** They make "we tried and could
/// not reach the service" visible instead of indistinguishable from "never
/// checked". The UI reads the latest **successful** check for the status and the
/// latest row of any kind for "last tried" — conflating them would report an
/// outage as an expired vignette.
///
/// `checkedAt` doubles as the rate limiter: see `vignetteCooldownRemaining` in
/// `lib/vignette-checks.ts`. No separate counter table, and it survives a cold
/// start because it lives here.
model VignetteCheck {
  id        String          @id @default(cuid())
  carId     String
  checkedAt DateTime        @default(now())
  outcome   VignetteOutcome

  /// Set only when `outcome` is ACTIVE. Naive datetimes, exactly as the service
  /// reports them — it sends no timezone, so inventing one would be a guess.
  validFrom      DateTime?
  validUntil     DateTime?
  vignetteNumber String?
  exempt         Boolean?

  /// Set only when `outcome` is UNAVAILABLE — why, for diagnosis.
  failureReason String?

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([checkedAt])
}

/// A photo attached to a car or to an expense.
///
/// **Nullable dual foreign keys**, per the standing decision: one table serves
/// both, rather than two near-identical ones. Exactly one of `carId`/`expenseId`
/// must be set, and that rule is a **CHECK constraint written by hand in the
/// migration** — Prisma cannot express it, the same reason 02-03's partial
/// unique indexes live in raw SQL. Without the constraint the rule would be a
/// comment, and comments do not reject rows.
///
/// `carId` exists from this migration even though car photos arrive in 04-04:
/// splitting one table across two migrations to defer a nullable column is
/// worse than declaring it once.
///
/// **The bytes are not here.** `storageKey` names an object in whatever backend
/// `lib/storage.ts` resolves — a local directory today, Supabase Storage in
/// 04-04. The key is opaque (`randomUUID` plus an extension derived from the
/// *validated* MIME type, never the client's filename) and never leaves the
/// server: `/api/attachments/[id]` takes the row id, checks ownership, and
/// streams the object itself.
model Attachment {
  id    String  @id @default(cuid())
  carId String?

  expenseId String?

  /// Opaque object key. Unique so a key can never be claimed by two rows.
  storageKey String @unique

  /// Validated against an allowlist AND against the file's leading bytes — a
  /// MIME string from a browser is a claim, not a fact.
  mimeType  String
  sizeBytes Int

  /// Stored so the <img> can carry width/height and reserve its space, which
  /// is what prevents layout shift without a client-side measurement.
  width  Int?
  height Int?

  createdAt DateTime @default(now())

  /// Cascade removes the ROW, which is why `deleteExpense` deletes the stored
  /// object first — a cascade the app never sees would orphan every object.
  car     Car?     @relation(fields: [carId], references: [id], onDelete: Cascade)
  expense Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([expenseId])
}

model OdometerReading {
  id      String         @id @default(cuid())
  carId   String
  date    DateTime
  /// Kilometres.
  reading Int
  source  OdometerSource @default(MANUAL)

  /// The expense this reading was captured alongside, if any.
  ///
  /// `source: EXPENSE` alone records only that a reading came from *some*
  /// fill-up, which is not enough to maintain it: matching back on
  /// (carId, date) is ambiguous — two fill-ups in one day is ordinary — and
  /// editing an expense's date would orphan its reading.
  ///
  /// Nullable because a manually entered reading has no expense. Unique because
  /// one expense captures at most one reading. Cascade because a reading must
  /// never outlive the fill-up it claims to measure: a stale one would silently
  /// corrupt the consumption series Phase 3 computes from it.
  expenseId String?  @unique
  expense   Expense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  car Car @relation(fields: [carId], references: [id], onDelete: Cascade)

  @@index([carId])
  @@index([date])
}
